# ──────────────────────────────────────────────────────────────────────────────
# Skeleton Shorts — Environment Variable Template
# Copy this file to `.env` and fill in your real API keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── Image Generation + Script / Voiceover (Google Gemini) ────────────────────
# Both the image generation (vision_service) and LLM (llm_service) use this key
GOOGLE_API_KEY=AIza...

# ── Video Generation (Kling via PiAPI) ────────────────────────────────────────
# Get your key at https://piapi.ai
PIAPI_KEY=...

# ── Audio (ElevenLabs) ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
# Pick a voice from https://elevenlabs.io/voice-library
# Recommended: Adam (deep, dramatic) — pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
